# ReturnGuard 构建上下文忽略（仓库根；build context = ..）
# 仅用于减少 docker build 发送到守护进程的内容，不影响 COPY 逻辑。
# 注意：不要排除 docker/ 与 demo/，否则 COPY docker/entrypoint.sh 与 COPY demo/ 会失败。

# 版本控制
.git
**/.git

# Python 缓存 / 测试与 lint 产物
**/__pycache__
**/*.pyc
.pytest_cache/
.ruff_cache/
_pytest_tmp.txt

# 大型数据集与资产（不进构建上下文；build context 仅取 demo/ 源码）
Dataset/
assets/
docs/
复赛交付物/
test_*.png
resp.json

# 文档（不进镜像）
*.md

# 本地数据库与密钥（运行时由 init_db 从 cases.json 重建，.env 由用户本地提供）
demo/cases.db
demo/cases_real.db
demo/.env
*.db
*.sqlite3

# 本地调试上传（运行时由容器生成，保留 .gitkeep 占位）
demo/uploads/*
!demo/uploads/.gitkeep

# ============================================================
# ReturnGuard 仓颉版部署环境变量示例
# 复制为 .env 后按需修改：cp .env.example .env
# docker compose -f docker/docker-compose.cangjie.yml 会读取同目录 .env 做变量替换
# （真实 .env 含密钥，已 gitignore，切勿提交仓库）
# ============================================================

# ----- openGauss 容器（必填） -----
# 超级用户 omm 与默认业务用户 gaussdb 的密码
# 要求：至少 8 位，且同时含大写字母、小写字母、数字、特殊符号(!?#@$%^&*-)
# 留空时 compose 直接报错中止，避免误用公开口令。
# 口令勿含 @/# 等 URL 保留字符，否则需做 URL 编码。
# 🔴 只设 GS_PASSWORD；设 GS_DBNAME 会触发 openGauss 5.0 初始化 bug。
GS_PASSWORD=

# ----- 宿主机映射端口（仅绑回环） -----
# 本机 65xxx 段被 Windows 保留，默认改到 58080 / 15433。
CJ_APP_PORT=58080
CJ_DB_PORT=15433

# ----- 应用：认证安全（公网部署必配） -----
# 令牌签名密钥，生产必填且 ≥32 字节；不设则服务拒绝启动。
# 生成：openssl rand -hex 32
AUTH_SECRET=

# 会话空闲超时（毫秒，滑动窗口；默认 24h，0=禁用）
RG_SESSION_IDLE_MS=86400000

# 经反向代理 / CDN 部署时须设为反代回环 IP，否则还原不到真实访客 IP
AUTH_TRUSTED_PROXIES=127.0.0.1

# 🔴 保持 0：仓颉连接池并发存在 dead lock；每次新建连接（连接串 5s 超时）
RG_DB_POOL=0

# ----- 应用：AI 平台（可选，无密钥时诚实回退 mock） -----
# 平台标识：tokenplan（默认）/ official / dashscope / openai / deepseek /
# moonshot / zhipu / siliconflow / openrouter / ollama / azure_openai / custom
# 完整矩阵见 GET /api/ai/providers 与 docs/AI_PROVIDERS.md
MODEL_ROUTER_PROFILE=tokenplan
RG_AI_BASE_URL=
RG_AI_KEY=
RG_AI_MODEL=qwen-plus

# 设置页保存的 AI 配置写入卷 cjappdata，重启服务后生效。
# GET/POST /api/ai/settings 需登录，密钥永不回传（只有 apiKeySet / apiKeyMask）。

# 常用平台密钥（用哪个填哪个；也可在设置页保存，无需写在这里）
# MODEL_ROUTER_API_KEY=
# MODEL_ROUTER_OFFICIAL_KEY=
# DASHSCOPE_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# MOONSHOT_API_KEY=
# ZHIPU_API_KEY=
# SILICONFLOW_API_KEY=
# OPENROUTER_API_KEY=
# AZURE_OPENAI_API_KEY=
# RG_CUSTOM_API_KEY=
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# ----- 本地仓颉后端直跑（不走 compose 时） -----
# RG_DB_HOST=127.0.0.1
# RG_DB_PORT=15433
# RG_DB_NAME=returnguard_cj
# RG_DB_USER=gaussdb
# RG_DB_PASSWORD=<与 GS_PASSWORD 相同>

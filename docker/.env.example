# ============================================================
# ReturnGuard 部署环境变量示例
# 复制为 .env 后按需修改：cp .env.example .env
# docker compose 在 docker/ 项目目录会自动读取同目录的 .env 做变量替换
# （真实 .env 含密钥，已 gitignore，切勿提交仓库）
# ============================================================

# ----- openGauss 容器（必填） -----
# 超级用户 omm 与默认业务用户 gaussdb 的密码
# 要求：至少 8 位，且同时含 大写字母、小写字母、数字、特殊符号(!?#@$%^&*-)
# 注意：若密码含 @/# 等 URL 保留字符，需在 DATABASE_URL 中做 URL 编码（@→%40，#→%23）。
# 默认密码 Gauss-2026 已避开这些字符，可直接使用。
# 数据库口令：必须自定义后填入，不可沿用示例口令。留空时 docker compose
# 会直接报错中止（compose 已去掉默认值），避免误用公开口令 Gauss-2026。
# 口令勿含 @/# 等 URL 保留字符，否则需做 URL 编码。
GS_PASSWORD=

# ----- 应用：AI 平台（可选，mock 模式可留空）-----
# MODEL_ROUTER_PROFILE = AI 平台标识（可选值见 GET /api/providers 或 docs/AI_PROVIDERS.md）：
#   tokenplan（默认）/ official / dashscope            —— 阿里云百炼系
#   openai / azure_openai / deepseek / moonshot / zhipu / siliconflow / openrouter
#   ollama（本地、免密钥）/ custom（自建 OpenAI 兼容端点）
# 切换无需手工对齐 base_url 与模型名：三者已随平台声明固化。
MODEL_ROUTER_PROFILE=tokenplan
MODEL_ROUTER_API_KEY=
MODEL_ROUTER_BASE_URL=
MODEL_ROUTER_OFFICIAL_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
# 其他平台（用哪个填哪个）
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# MOONSHOT_API_KEY=
# ZHIPU_API_KEY=
# SILICONFLOW_API_KEY=
# OPENROUTER_API_KEY=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# RG_CUSTOM_BASE_URL=
# RG_CUSTOM_API_KEY=
# 逐能力覆盖模型标识（可选）
# RG_MODEL_TEXT= / RG_MODEL_VL= / RG_MODEL_OCR= / RG_MODEL_EMBED= / RG_MODEL_RERANK= / RG_MODEL_TTS=

# ----- 应用：安全加固（公网部署必配） -----
# 以下四项若留空，对应的保护会静默降级：令牌重启失效 / 公开账号可改写全局阈值 /
# 限流坍缩为单例 / 开放注册被意外放行。生成方式：
#   python -c "import secrets;print(secrets.token_hex(32))"
AUTH_SECRET=
ADMIN_API_KEY=
# 公网演示建议 false，统一使用内置 demo/demo123
REGISTRATION_ENABLED=false
REGISTRATION_INVITE_CODE=
# 经反向代理 / CDN 部署时须设为 127.0.0.1，否则还原不到真实访客 IP
AUTH_TRUSTED_PROXIES=127.0.0.1
LOGIN_MAX_FAILS=5
LOGIN_LOCK_MIN=15
# 公网跨域白名单（逗号分隔具体域名，禁止 *）
CORS_ALLOW_ORIGINS=

# ----- 应用：上传图存储（本机自持，不依赖第三方云对象存储） -----
# 默认留空 = 纯本地模式：退货图落 demo/uploads/，经 HMAC 签名短链访问，功能完整。
# 仅当希望 live 视觉模型由服务端回源拉图时才配 RG_SELF_IMAGE_BASE（自托管反向代理）。
RG_SELF_IMAGE_BASE=
PUBLIC_IMAGE_BASE=
UPLOAD_URL_TTL=3600

# ----- 演示库重置开关 -----
# FORCE_RESEED=1 仅重建 demo 演示种子，real 源真实数据不动
FORCE_RESEED=

# ----- 构建期 pip 源（可选，但国内强烈建议） -----
# 直连 PyPI 在部分网络下会 read timeout / 下载中断，表现为构建报
# "THESE PACKAGES DO NOT MATCH THE HASHES"（本质是 wheel 下载损坏）。
# 设成国内镜像可显著提速并避免失败：
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# 默认值（不设时）：https://pypi.org/simple —— 行为与历史一致

# ----- 直连已有 openGauss（不走 compose 内置 db 时取消注释并填真实值） -----
# DATABASE_URL=postgresql+psycopg2://gaussdb:你的密码@数据库主机IP:5432/returnguard
# REAL_DATABASE_URL=postgresql+psycopg2://gaussdb:你的密码@数据库主机IP:5432/returnguard_real


# ---- live 模式独立配额闸（SEC-13）：防公开演示账号刷付费 Key ----
# 公网演示账号是公开凭据，live 链路真实计费，故按天另设闸门；0 = 关闭该层。
LIVE_QUOTA_GLOBAL_DAY=300
LIVE_QUOTA_TENANT_DAY=60
LIVE_QUOTA_IP_HOUR=20
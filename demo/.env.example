# ReturnGuard 本地密钥 / 网关配置模板
# 复制为 .env 并填入真实值；.env 已被 .gitignore 忽略，请勿提交真实密钥。
# 真实 .env 示例（密钥脱敏）：
#   MODEL_ROUTER_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
#   MODEL_ROUTER_API_KEY=sk-sp-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#   PUBLIC_IMAGE_BASE=
MODEL_ROUTER_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
MODEL_ROUTER_API_KEY=请替换为你的TokenPlan_APIKey
# 默认文本推理模型（质量优先 qwen3.7-max；演示求快可切 kimi-k2.6 / deepseek-v4-pro / qwen3.6-flash）
MODEL_ROUTER_TEXT_MODEL=qwen3.7-max
PUBLIC_IMAGE_BASE=

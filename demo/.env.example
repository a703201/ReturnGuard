# ============================================================
# ReturnGuard 部署环境变量示例
# 复制为 .env 后按需修改：cp .env.example .env
# docker compose 会自动读取同目录的 .env
# ============================================================

# ----- openGauss 容器（必填） -----
# 超级用户 omm 与默认业务用户 gaussdb 的密码
# 要求：至少 8 位，且同时含 大写字母、小写字母、数字、特殊符号(!?#@$%^&*-)
GS_PASSWORD=Gauss@2026

# ----- 应用（可选） -----
# live 模式（阶段B LLM 归因）所需，mock 模式可留空
MODEL_ROUTER_API_KEY=
MODEL_ROUTER_BASE_URL=
# 公网图床前缀（单案举证图片外链用），本地演示可留空
PUBLIC_IMAGE_BASE=

# ----- 直连已有 openGauss（不走 compose 内置 db 时取消注释并填真实值） -----
# DATABASE_URL=postgresql+psycopg2://gaussdb:你的密码@数据库主机IP:5432/returnguard

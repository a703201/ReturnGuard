# ReturnGuard 本地密钥 / 网关配置模板
# 复制为 .env 并填入真实值；.env 已被 .gitignore 忽略，请勿提交真实密钥。
# 真实 .env 示例（密钥脱敏）：
#   MODEL_ROUTER_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
#   MODEL_ROUTER_API_KEY=sk-sp-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#   PUBLIC_IMAGE_BASE=
MODEL_ROUTER_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
MODEL_ROUTER_API_KEY=请替换为你的TokenPlan_APIKey
# 默认文本推理模型（质量优先 qwen3.7-max；演示求快可切 kimi-k2.6 / deepseek-v4-pro / qwen3.6-flash）
MODEL_ROUTER_TEXT_MODEL=qwen3.7-max
PUBLIC_IMAGE_BASE=

# ---- 七牛云图床（P3-17，个人图床）----
# 以下条件齐备才启用 qiniu 后端：ACCESS_KEY + SECRET_KEY + BUCKET + DOMAIN
# DOMAIN 为存储桶公网域名；KEY_PREFIX 为"文件夹"前缀（如 ReturnGuard）
QINIU_ACCESS_KEY=请替换为你的七牛AccessKey
QINIU_SECRET_KEY=请替换为你的七牛SecretKey
QINIU_BUCKET=请替换为你的存储桶名称
QINIU_DOMAIN=https://你的图床域名
QINIU_KEY_PREFIX=ReturnGuard

# ---- 认证安全加固（防 spam / 防攻击）----
# 令牌签名密钥（生产必设！未设则用进程内随机密钥，重启令所有令牌失效，且不利于统一轮换）
AUTH_SECRET=请替换为至少32字节的高熵随机串
# 注册开放开关：true=开放注册；false=关闭注册（返回 403）
REGISTRATION_ENABLED=true
# 邀请码：留空=不要求；非空=注册须带匹配的 invite_code
REGISTRATION_INVITE_CODE=
# 注册限流：每 IP 每分钟注册上限（建一个租户=一套隔离数据，默认从严）
AUTH_REGISTER_LIMIT=10
# 登录限流：每 IP 每分钟登录上限
AUTH_LOGIN_IP_LIMIT=30
# 单用户名连续登录失败上限（达到后临时锁定）
LOGIN_MAX_FAILS=5
# 登录失败锁定持续时间（分钟）
LOGIN_LOCK_MIN=15
# 可信代理 IP/CIDR（逗号分隔）：仅当直连客户端在此列表时才采纳 X-Forwarded-For / X-Real-IP
AUTH_TRUSTED_PROXIES=
# 公网部署跨域白名单（逗号分隔具体域名，禁止 *）；留空=不挂 CORS（同源）
CORS_ALLOW_ORIGINS=

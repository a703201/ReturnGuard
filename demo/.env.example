# ReturnGuard 本地密钥 / 网关配置模板
# 复制为 .env 并填入真实值；.env 已被 .gitignore 忽略，请勿提交真实密钥。

# ================= 阿里云百炼模型网关（双 profile 一键切换）=================
# MODEL_ROUTER_PROFILE:
#   tokenplan（默认）= Token Plan 专属网关，本地测试/开发用（与专属 Key 配套）
#   official         = 赛事指定「阿里云百炼 Model Router」(model-router.edu-aliyun.com)，复赛提交演示用
# 切换只需改这一个变量；各 profile 的 base_url 有默认值，无需手填。
MODEL_ROUTER_PROFILE=tokenplan
# —— tokenplan profile（本地测试）——
# 可用 MODEL_ROUTER_BASE_URL 覆盖基地址；Token Plan 专属 Key（与专属基地址配套，dashscope 通用地址不抵扣套餐）
MODEL_ROUTER_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
MODEL_ROUTER_API_KEY=请替换为你的TokenPlan_APIKey
# —— official profile（赛事指定 Model Router）——
# 基地址固定为 https://model-router.edu-aliyun.com/v1（切换 profile 自动生效，无需手填；
#   极少数情况需自定义地址时再用 MODEL_ROUTER_OFFICIAL_BASE_URL 覆盖，一般不动）。
# 密钥为组委会发放的赛事 Key（与 Token Plan Key 不通用），拿到后填入下值即可一键切过去演示：
MODEL_ROUTER_OFFICIAL_KEY=请填入组委会发放的赛事ModelRouter_Key
# MODEL_ROUTER_OFFICIAL_BASE_URL=https://model-router.edu-aliyun.com/v1
# 默认文本推理模型（质量优先 qwen3.7-max；演示求快可切 kimi-k2.6 / deepseek-v4-pro / qwen3.6-flash）
MODEL_ROUTER_TEXT_MODEL=qwen3.7-max
# ---- 上传图存储（可插拔后端：默认本地自持；远端图床为预留接口）----
# IMAGE_BED 显式指定后端：local / self / public_base / qiniu；留空 = 自动优先级 self > public_base > local。
#   复赛演示用本地：上传图落本机 demo/uploads/，经 HMAC 签名短链 /api/file/{sig} 短期访问。
# 自托管增强（非云服务）——仅在 live 视觉模型需要"服务端回源拉图"时才配；
# 视觉调用默认已走 base64 内联本地文件，这两个变量留空完全不影响功能：
#   RG_SELF_IMAGE_BASE=https://<你的隧道域名>/api/img   ← 经本服务隧道暴露，退货图不出境
#   PUBLIC_IMAGE_BASE=https://<你的反代域名>/uploads     ← 已有自建反代时使用
IMAGE_BED=
RG_SELF_IMAGE_BASE=
PUBLIC_IMAGE_BASE=
# ---- 远端对象存储（预留，默认关闭；复赛不启用）----
# 仅当 IMAGE_BED=qiniu 且下列四项齐备时启用；qiniu SDK 为可选依赖（pip install qiniu），
# 未安装/配置缺失会自动降级 local，不影响上传主流程。切勿把真实密钥提交进仓库。
# QINIU_ACCESS_KEY=
# QINIU_SECRET_KEY=
# QINIU_BUCKET=
# QINIU_DOMAIN=
# QINIU_KEY_PREFIX=ReturnGuard

# ---- 认证安全加固（防 spam / 防攻击）----
# 令牌签名密钥（生产必设！未设则用进程内随机密钥，重启令所有令牌失效，且不利于统一轮换）
# 生成：python -c "import secrets;print(secrets.token_hex(32))"
AUTH_SECRET=请替换为至少32字节的高熵随机串
# 管理员密钥（独立变量）：用于 /api/calibrate 等管理动作；未设则退化为要求登录，但建议公网部署必设
# 生成：python -c "import secrets;print(secrets.token_hex(24))"
ADMIN_API_KEY=请替换为高熵随机串（公网部署强烈建议设置）
# 注册开放开关：true=开放注册；false=关闭注册（返回 403）。公网体验地址建议 false，评委用内置 demo/demo123
REGISTRATION_ENABLED=false
# 邀请码：留空=不要求；非空=注册须带匹配的 invite_code
REGISTRATION_INVITE_CODE=
# 注册限流：每 IP 每分钟注册上限（建一个租户=一套隔离数据，默认从严）
AUTH_REGISTER_LIMIT=10
# 登录限流：每 IP 每分钟登录上限
AUTH_LOGIN_IP_LIMIT=30
# 单用户名连续登录失败上限（达到后临时锁定）
LOGIN_MAX_FAILS=5
# 登录失败锁定持续时间（分钟）
LOGIN_LOCK_MIN=15
# 可信代理 IP/CIDR（逗号分隔）：仅当直连客户端在此列表时才采纳 CF-Connecting-IP / X-Forwarded-For / X-Real-IP。
# 经 Cloudflare Tunnel 部署时直连 IP 恒为 127.0.0.1，须设为 127.0.0.1 才能正确还原真实访客 IP（否则限流坍缩为全局单桶）
AUTH_TRUSTED_PROXIES=127.0.0.1
# 公网部署跨域白名单（逗号分隔具体域名，禁止 *）；留空=不挂 CORS（同源）
CORS_ALLOW_ORIGINS=


# ---- live 模式独立配额闸（SEC-13）：防公开演示账号刷付费 Key ----
# 公网演示账号是公开凭据，live 链路真实计费，故按天另设闸门；0 = 关闭该层。
LIVE_QUOTA_GLOBAL_DAY=300
LIVE_QUOTA_TENANT_DAY=60
LIVE_QUOTA_IP_HOUR=20
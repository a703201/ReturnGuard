# ============================================================
# ReturnGuard 根 .gitignore（仓颉后端 + Vue3 前端 + Rust 启动器）
# 覆盖运行期产物与密钥，避免误提交（尤其 docker/.env 含数据库密码）
# ============================================================

# 密钥 / 环境变量（含密码，绝不能入库）
.env
.env.*
!.env.example

# 日志
*.log

# 本地数据库 / 运行期状态
*.db
*.db-wal
*.db-shm
*.sqlite3

# 前端依赖与本地 lock（构建锁在 web/package-lock.json）
node_modules/
package-lock.json

# Rust 启动器构建产物
launcher/target/

# 仓颉后端本地构建产物（镜像构建在容器内完成，无需入库）
backend/build/
backend/probe/
backend/probe_db/
backend/data/

# 编辑器 / 系统
.idea/
.vscode/
.DS_Store

# ============================================================
# 数据集原始文件（体积大，不入库；已移出仓库存于项目外归档）
# 若后续重新引入，仍按此规则忽略。
# ============================================================
Dataset/
